uploads/minigame/

# Gelistirme bagimliliklari (yerel onizleme)
node_modules/

# Ortam dosyalari
.env

# Hosting hata loglari
error_log
*.log

# Yuklenen videolar (buyuk dosyalar repoya girmesin)
